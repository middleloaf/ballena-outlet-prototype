{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ballena-outlet",
  // Elliott's Cloudflare account (production owner).
  "account_id": "7c8db1ed574fe9e54ca06cf9c86ead63",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The repo root is the static site. .assetsignore keeps tooling, source
  // workbooks and the Worker code itself out of the public bundle.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls hit the Worker; every page/image is served straight from
    // the asset store without invoking (or billing) the Worker.
    "run_worker_first": ["/api/*"]
  }
}
