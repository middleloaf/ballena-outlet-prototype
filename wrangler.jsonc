{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ballena-outlet",
  // Elliott's Cloudflare account (production owner).
  "account_id": "7c8db1ed574fe9e54ca06cf9c86ead63",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Published inventory, version history, the pending draft and uploaded images.
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "ballena-inventory" }],
  "vars": {
    // Who may use /admin and the admin API (comma-separated).
    "ADMIN_EMAILS": "elliottvarnold@gmail.com",
    // Cloudflare Access application protecting /admin* (set after Zero Trust is enabled).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // The repo root is the static site. .assetsignore keeps tooling, source
  // workbooks and the Worker code itself out of the public bundle.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker runs only for the API, the admin panel (auth check), the
    // published inventory and uploaded images (R2). Every other page and image
    // is served straight from the asset store.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/data/inventory.json", "/assets/inventory/*"]
  }
}
